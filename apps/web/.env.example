# The site and viewer. Sessions are stored and streamed by the Go server
# (github.com/biga-sh/server); this app only renders them.
# Copy this file to .env.local.

# Where the Go server answers. /api/sessions/* is proxied there, so the viewer
# and the CLI can keep using this origin. Defaults to http://localhost:8080 in
# development. Leave it unset in production when a reverse proxy already
# routes /api/sessions to the server (the Docker setup does).
# BIGA_SERVER_URL="http://localhost:8080"

# Optional. Have browsers call the server directly instead of through this
# origin, e.g. a Vercel site with the server hosted elsewhere. The server must
# then allow this site in BIGA_CORS_ORIGINS. Baked in at build time.
# NEXT_PUBLIC_BIGA_API_URL="https://api.biga.example.com"

# Public site origin, used for absolute metadata URLs (Open Graph, sitemap,
# robots, JSON-LD). Defaults to http://localhost:3000 in dev.
# NEXT_PUBLIC_SITE_URL="https://biga.example.com"

# The finished session the landing page embeds. Set the same value on the Go
# server too so its retention sweep never deletes it.
# BIGA_DEMO_SESSION_ID="heczlzfa"
