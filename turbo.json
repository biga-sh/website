{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "CRON_SECRET",
    "NEXT_PUBLIC_SITE_URL",
    "BIGA_EAGER_MAX_BYTES",
    "BIGA_EAGER_MAX_FILES",
    "BIGA_SESSION_STALE_MS",
    "BIGA_MAX_SNAPSHOT_BYTES",
    "BIGA_MAX_CHECKPOINT_BYTES",
    "BIGA_MAX_SESSION_BYTES",
    "BIGA_RETENTION_DAYS",
    "BIGA_DEMO_SESSION_ID",
    "SPIRE_EAGER_MAX_BYTES",
    "SPIRE_EAGER_MAX_FILES",
    "SPIRE_SESSION_STALE_MS",
    "SPIRE_MAX_SNAPSHOT_BYTES",
    "SPIRE_MAX_CHECKPOINT_BYTES",
    "SPIRE_MAX_SESSION_BYTES",
    "SPIRE_RETENTION_DAYS",
    "SPIRE_DEMO_SESSION_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "web#build": {
      "dependsOn": [
        "^build",
        "web#check-types"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "@biga/types#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@biga/stores#build": {
      "dependsOn": [
        "@biga/types#build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@biga/db#build": {
      "dependsOn": [
        "@biga/types#build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@biga/redis#build": {
      "dependsOn": [
        "@biga/types#build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@biga/server#build": {
      "dependsOn": [
        "@biga/db#build",
        "@biga/redis#build",
        "@biga/types#build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@zenshilabs/spire#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "web#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "@biga/types#build",
        "@biga/stores#build",
        "@biga/db#build",
        "@biga/redis#build",
        "@biga/server#build"
      ]
    }
  }
}
