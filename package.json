{
  "name": "biga",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web",
    "dev:web": "turbo run dev --filter=web",
    "lint": "turbo run lint --ui=stream",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @biga/db db:generate",
    "db:migrate": "pnpm --filter @biga/db db:migrate",
    "db:push": "pnpm --filter @biga/db db:push"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  }
}
